# ── Exo 分散式 LLM Endpoint ──────────────────────────────────────────
# 把下面 IP 換成「跑 Exo 的那台」的 Tailscale IP（100.x.x.x）
# 如果 n8n 和 Exo 在同一台，可以用 localhost
LLM_BASE_URL=http://100.x.x.x:52415/v1

# 模型選擇（二選一，32B 需要兩台同時在線）
LLM_MODEL=mlx-community/Qwen2.5-32B-Instruct-4bit
# LLM_MODEL=mlx-community/Qwen2.5-14B-Instruct-4bit

# Exo 不需要真實 API key，填任意字串即可
LLM_API_KEY=sk-exo

# ── Open WebUI ────────────────────────────────────────────────────────
# 自動從 LLM_BASE_URL 繼承，通常不需要改
